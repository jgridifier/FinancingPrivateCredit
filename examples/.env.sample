# Sample Environment Variables for FinancingPrivateCredit
# Copy this file to .env and fill in your API keys

# =============================================================================
# FRED API (Federal Reserve Economic Data)
# =============================================================================
# Get your free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Required for: All indicators (macro data)
FRED_API_KEY=your_fred_api_key_here

# =============================================================================
# LLM APIs (for enhanced 8-K extraction)
# =============================================================================
# Anthropic Claude API
# Get your key at: https://console.anthropic.com/
# Required for: FASAR indicator (commitment letter LLM analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (alternative to Anthropic)
# Get your key at: https://platform.openai.com/api-keys
# Optional: Can be used instead of Anthropic for LLM extraction
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# SEC EDGAR (No API key required)
# =============================================================================
# SEC EDGAR is public and does not require an API key
# However, you should set a proper user agent for rate limiting compliance
# Format: "Company/App Name contact@email.com"
SEC_USER_AGENT="FinancingPrivateCredit research@example.com"

# =============================================================================
# Yahoo Finance (No API key required)
# =============================================================================
# Stock data is fetched via yfinance library
# No API key needed for basic usage

# =============================================================================
# Data Cache Configuration (Optional)
# =============================================================================
# Override default cache directory
# Default: ~/.local/share/financing_private_credit/data_cache
# DATA_CACHE_DIR=/path/to/your/cache

# Force refresh all cached data (set to "true" to bypass cache)
# FORCE_REFRESH=false
